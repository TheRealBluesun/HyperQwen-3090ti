+def _sda_ext():
+    """qwen27-dev: JIT-build (once, cached under ~/.cache/torch_extensions) and load the CUDA
+    split-KV partial + combine kernels. None if the build fails -> Triton path."""
+    global _SDA_EXT
+    if _SDA_EXT is False:
+        try:
+            from torch.utils.cpp_extension import load
+
+            src = os.path.join(os.path.dirname(os.path.abspath(__file__)), "qwen27_sda.cu")
+            _SDA_EXT = load(name="qwen27_sda", sources=[src],
+                            extra_cuda_cflags=["-O3", "-gencode=arch=compute_86,code=sm_86"])
+        except Exception as e:  # noqa: BLE001
+            import logging
+
+            logging.getLogger(__name__).warning("qwen27_sda CUDA kernel unavailable (%s); using Triton", e)
+            _SDA_EXT = None
+    return _SDA_EXT
+
+
+_NUM_SMS = {}
+
+
+def _num_sms(device):
+    if device not in _NUM_SMS:
+        _NUM_SMS[device] = torch.cuda.get_device_properties(device).multi_processor_count
+    return _NUM_SMS[device]
