[Unit]
Description=HyperQwen (patched vLLM 0.29) Qwen3.8-27B W4A16 instance A (GPU0, 128k ctx, DFlash2, port 8001)
After=network.target
Conflicts=buun-27b-a.service orcabonsai.service qwen38.service

[Service]
# Pinned KV pool 176 MiB under the profile default (5583457484): still 131,328 tokens (>= 128K) but leaves
# activation headroom. At the default, two concurrent prefills OOMed the 3090 Ti by 24 MiB (2026-09-25).
Environment=KV_MEM=5398908108
Type=simple
ExecStart=%h/build/HyperQwen/local-3090ti/deploy/run.sh
Restart=always
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=default.target
