[Unit]
Description=HyperQwen (patched vLLM 0.29) Qwen3.8-27B W4A16 instance B (GPU1, 128k ctx, DFlash2, port 8002)
After=network.target
Conflicts=buun-27b-b.service

[Service]
# Pinned KV pool 176 MiB under the profile default (5583457484): still 131,328 tokens (>= 128K) but leaves
# activation headroom. At the default, two concurrent prefills OOMed the 3090 Ti by 24 MiB (2026-09-25).
Environment=KV_MEM=5398908108
# vLLM overlay with patches 03-12 (a copy of the venv package; see local-3090ti/patches) + the Marlin M<=16 table (patch 08)
Environment=PYTHONPATH=%h/build/HyperQwen/dev/site
Environment=VLLM_MARLIN_TUNE=1
Type=simple
Environment=GPU=1
Environment=PORT=8002
ExecStart=%h/build/HyperQwen/local-3090ti/deploy/run.sh
Restart=always
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=default.target
