     @classmethod
+    def _find_partial_tail_hit(
+        cls,
+        fine: BlockHashList,
+        max_length: int,
+        kv_cache_group_ids: list[int],
+        block_pool: BlockPool,
+        kv_cache_spec: SlidingWindowSpec,
+        alignment_tokens: int,
+    ) -> tuple[tuple[list[KVCacheBlock], ...], int] | None:
+        """qwen27: a hit ending inside a block, at a partial tail another request registered.
+
+        Probes the hash boundaries of the block containing ``max_length`` high to low (longest
+        first, like FullAttentionManager's phase 2). A hit at H needs every token the window
+        still attends from position H, i.e. [H - sliding_window + 1, H): the full blocks
+        covering it plus the partial block itself. The partial block is shared; the base
+        manager's copy-on-write privatises it before the request writes past H.
+        """
+        block_size = kv_cache_spec.block_size
+        scale = block_size // alignment_tokens
+        p = max_length // block_size
+        lo = p * scale
+        hi = min(max_length // alignment_tokens, lo + scale - 1, len(fine))
+        for fine_idx in range(hi - 1, lo - 1, -1):
+            tail = block_pool.get_cached_block(fine[fine_idx], kv_cache_group_ids)
+            if not tail:
+                continue
+            hit_length = (fine_idx + 1) * alignment_tokens
+            first = max(0, hit_length - kv_cache_spec.sliding_window + 1) // block_size
+            computed: tuple[list[KVCacheBlock], ...] = tuple(
+                [block_pool.null_block] * first for _ in kv_cache_group_ids
+            )
+            ok = True
+            for j in range(first, p):
+                cached = block_pool.get_cached_block(fine[(j + 1) * scale - 1], kv_cache_group_ids)
+                if not cached:
+                    ok = False
+                    break
+                for c, b in zip(computed, cached):
+                    c.append(b)
+            if not ok:
+                continue
+            for c, b in zip(computed, tail):
+                c.append(b)
+            return computed, hit_length
+        return None
+
+    def cache_blocks(
+        self,
+        request: Request,
+        num_tokens: int,
+        retention_interval: int | None = None,
+    ) -> None:
+        super().cache_blocks(request, num_tokens, retention_interval=retention_interval)
+        hash_block_size = self.block_pool.hash_block_size
+        if self.block_size == hash_block_size or self.cache_hit_alignment_tokens >= self.block_size:
+            return
